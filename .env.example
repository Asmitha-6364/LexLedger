POSTGRES_DB=lexledger
POSTGRES_USER=lexledger
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lexledger:replace-with-a-long-random-password@localhost:5432/lexledger

REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_URL=redis://:replace-with-a-long-random-redis-password@localhost:6379/0

RABBITMQ_DEFAULT_USER=lexledger
RABBITMQ_DEFAULT_PASS=replace-with-a-long-random-rabbitmq-password
RABBITMQ_URL=amqp://lexledger:replace-with-a-long-random-rabbitmq-password@localhost:5672/

LEXLEDGER_ELECTION_SECRET=replace-with-a-long-random-election-secret
LEXLEDGER_RESPONSE_SIGNING_SECRET=replace-with-a-long-random-response-signing-secret
LEXLEDGER_RATE_LIMIT_PER_MINUTE=300
